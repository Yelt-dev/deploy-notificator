# ==============================================
# NOTIFICADOR CENTRALIZADO - Configuración
# ==============================================
# Usa este archivo si vas a usar UN notificador para MÚLTIPLES proyectos
# y pasarás app-name y app-url como argumentos CLI

# Email Configuration
SMTP_SERVICE=gmail
SMTP_USER=deploy-bot@company.com
SMTP_APP_PASSWORD=your-app-password-here

# Notification Recipients (comma-separated)
EMAIL_RECIPIENTS=dev-team@company.com,lead@company.com,devops@company.com

# Sender Information
SENDER_NAME=Deploy Bot

# Environment (opcional, puedes cambiarlo por proyecto si lo necesitas)
ENVIRONMENT=production

# ==============================================
# NOTA IMPORTANTE:
# ==============================================
# NO necesitas definir APP_NAME_FRONTEND, APP_NAME_BACKEND, etc.
# Pasarás esos valores como argumentos cuando ejecutes el notificador:
#
# node /opt/deploy-notificator/src/notificator.js \
#   --type frontend \
#   --app-name "Mi E-commerce" \
#   --app-url "https://shop.mycompany.com"
#
# node /opt/deploy-notificator/src/notificator.js \
#   --type backend \
#   --app-name "Payment API" \
#   --app-url "https://api-payment.mycompany.com"
