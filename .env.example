# Email Configuration
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password-here

# Notification Recipients (comma-separated)
EMAIL_RECIPIENTS=dev1@company.com,dev2@company.com

# Sender Information
SENDER_NAME=Deploy Bot

# Application Information
APP_NAME_FRONTEND=My Frontend App
APP_URL_FRONTEND=https://app.example.com

APP_NAME_BACKEND=My Backend API
APP_URL_BACKEND=https://api.example.com

# Environment
ENVIRONMENT=production
