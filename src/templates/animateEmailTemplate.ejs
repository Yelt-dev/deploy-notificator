<html>
  <head>
    <title><%= subject %></title>
  </head>
  <body>
    <div
      style="
        width: 90%;
        background-color: white;
        border-radius: 5px;
        padding: 10px;
        margin: 0 auto;
      "
    >
      <table style="width: 100%">
        <tr>
          <th>
            <img
              src="https://cdn.dribbble.com/users/1081211/screenshots/3248162/icon_3_2x.gif"
              alt=""
              style="height: 100px; margin: 0 auto"
            />
            <h3
              style="
                text-transform: uppercase;
                color: #29aaa0;
                text-align: center;
              "
            >
              <%= title %>
            </h3>
          </th>
        </tr>
        <tr>
          <td>
            <p style="color: #29aaa0; text-align: center">
              <%= body %><br />
              <small style="color: gainsboro; text-align: center"
                >Si existe algun problema o inconveniente responda este
                correo.</small
              >
            </p>
          </td>
        </tr>
        <% if (gitInfo && gitInfo.commit !== 'N/A') { %>
        <tr>
          <td>
            <div style="background-color: #f5f5f5; border-radius: 5px; padding: 15px; margin: 10px 0;">
              <h4 style="color: #333; margin-top: 0;">Información de Git</h4>
              <table style="width: 100%; font-size: 14px;">
                <tr>
                  <td style="padding: 5px; color: #666;"><strong>Branch:</strong></td>
                  <td style="padding: 5px; color: #333;"><%= gitInfo.branch %></td>
                </tr>
                <tr>
                  <td style="padding: 5px; color: #666;"><strong>Commit:</strong></td>
                  <td style="padding: 5px; color: #333;"><code><%= gitInfo.commit %></code></td>
                </tr>
                <tr>
                  <td style="padding: 5px; color: #666;"><strong>Autor:</strong></td>
                  <td style="padding: 5px; color: #333;"><%= gitInfo.author %></td>
                </tr>
                <tr>
                  <td style="padding: 5px; color: #666;"><strong>Mensaje:</strong></td>
                  <td style="padding: 5px; color: #333;"><%= gitInfo.message %></td>
                </tr>
                <tr>
                  <td style="padding: 5px; color: #666;"><strong>Fecha:</strong></td>
                  <td style="padding: 5px; color: #333;"><%= dateString %> <%= timeString %></td>
                </tr>
                <% if (environment) { %>
                <tr>
                  <td style="padding: 5px; color: #666;"><strong>Entorno:</strong></td>
                  <td style="padding: 5px; color: #333;"><%= environment %></td>
                </tr>
                <% } %>
              </table>
            </div>
          </td>
        </tr>
        <% } %>
        <tr>
          <td style="text-align: center; padding: 10px">
            <br />
            <a
              href="<%= urlapp %>"
              style="
                background-color: #027eef;
                margin: 10px;
                padding: 10px;
                border-radius: 5px;
                text-decoration: none;
                color: white;
              "
              >Aplicación</a
            >
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
